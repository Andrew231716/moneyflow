# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: show demo seed button when dashboard is empty
NEXT_PUBLIC_ENABLE_DEMO_SEED=true

# Open Banking / GoCardless Bank Account Data (server-only — sibling agent)
# Do NOT expose these as NEXT_PUBLIC_*
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
OPEN_BANKING_REDIRECT_URL=http://localhost:3000/api/open-banking/callback
# Optional absolute origin used by the callback redirect (defaults to request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
