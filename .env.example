# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only: required for Vercel Cron bank sync (bypasses RLS). Never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: show demo seed button when dashboard is empty
NEXT_PUBLIC_ENABLE_DEMO_SEED=true

# Open Banking — server-only (never NEXT_PUBLIC_*)
# Default provider is Enable Banking (GoCardless closed to new signups).
# Override: OPEN_BANKING_PROVIDER=enablebanking|gocardless
OPEN_BANKING_PROVIDER=enablebanking

# Enable Banking (https://enablebanking.com) — paste from Control Panel
# Application ID + RSA private key (PEM). In .env.local you can keep newlines
# or use literal \n escapes in a single line.
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY=

# Legacy / optional GoCardless Bank Account Data
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Must match the redirect URL whitelisted in the provider control panel.
# Production: https://moneyflow-ecru.vercel.app/api/open-banking/callback
OPEN_BANKING_REDIRECT_URL=http://localhost:3000/api/open-banking/callback
# Optional absolute origin used by the callback redirect (defaults to request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron: Authorization Bearer for /api/cron/open-banking-sync (every 6h).
# Generate a long random string and set the same value in Vercel project env.
# CRON_SECRET=
